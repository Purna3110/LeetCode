class Solution:
    def lexicographicallySmallestArray(self, nums, limit):
        n = len(nums)

        # (value, original index)
        arr = [(nums[i], i) for i in range(n)]

        # Sort by value
        arr.sort()

        ans = [0] * n

        left = 0

        while left < n:
            right = left

            # Find the connected group
            while right + 1 < n and arr[right + 1][0] - arr[right][0] <= limit:
                right += 1

            # Get original indices
            indices = [arr[i][1] for i in range(left, right + 1)]

            # Sort indices so smallest values go to smallest positions
            indices.sort()

            # Assign values
            for i in range(len(indices)):
                ans[indices[i]] = arr[left + i][0]

            left = right + 1

        return ans
