class Solution:
    def winnerSquareGame(self, n: int) -> bool:
        dp = [False] * (n + 1)

        for i in range(1, n + 1):
            j = 1

            while j * j <= i:
                square = j * j

                # If opponent is in a losing state,
                # current player can win.
                if dp[i - square] == False:
                    dp[i] = True
                    break

                j += 1

        return dp[n]
